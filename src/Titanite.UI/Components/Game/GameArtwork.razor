@if (Source is not null && !HasFailed)
{
    <img class="artwork artwork-@ShapeClass"
         src="@Source"
         alt=""
         loading="lazy"
         decoding="async"
         @onerror="OnLoadFailed"/>
}
else
{
    <span class="artwork artwork-@ShapeClass artwork-fallback" aria-hidden="true">@Initials</span>
}
