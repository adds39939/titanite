<section class="scale">
    <div class="scale-row">
        <div class="scale-label">
            <h2>Interface scale</h2>
            <p>Makes text and controls larger or smaller across the whole app.</p>
        </div>

        <div class="scale-control">
            @if (IsLoading)
            {
                <span class="control-note">Reading…</span>
            }
            else
            {
                <div class="slider">
                    <input class="slider-input"
                           type="range"
                           min="@InterfaceScales.Minimum"
                           max="@InterfaceScales.Maximum"
                           step="@InterfaceScales.Step"
                           value="@Shown"
                           disabled="@IsBusy"
                           aria-label="Interface scale"
                           aria-valuetext="@Describe(Shown)"
                           @oninput="OnSliding"
                           @onchange="OnSlidAsync"/>

                    <div class="marks">
                        @foreach (var scale in InterfaceScales.Supported)
                        {
                            <button type="button"
                                    class="@MarkClass(scale)"
                                    disabled="@IsBusy"
                                    tabindex="-1"
                                    title="@Describe(scale)"
                                    @onclick="() => ChooseAsync(scale)"
                                    @key="scale">
                                @scale%
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @if (Message is not null)
    {
        <p class="message is-error">@Message</p>
    }
</section>
