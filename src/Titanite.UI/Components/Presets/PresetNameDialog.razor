<div class="backdrop" @onclick="Cancel" @onkeydown="OnKeyDown">
    <div class="panel"
         role="dialog"
         aria-modal="true"
         aria-label="@Title"
         @onclick:stopPropagation="true">
        <h2 class="title">@Title</h2>
        <p class="note">@Note</p>

        <input class="name"
               type="text"
               aria-label="Preset name"
               placeholder="Preset name"
               spellcheck="false"
               maxlength="@MaximumLength"
               autofocus
               value="@Name"
               @oninput="OnNameInput"/>

        <div class="actions">
            <Button OnClick="Cancel">Cancel</Button>

            <Button Variant="ButtonVariant.Primary" Disabled="@(!CanConfirm)" OnClick="Confirm">
                @ConfirmLabel
            </Button>
        </div>
    </div>
</div>
