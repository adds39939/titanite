@if (Topology.IsEmpty)
{
    <p class="empty">The processor topology could not be read, so only a manual mask is offered.</p>
}
else
{
    <p class="summary">
        @Topology.AllThreads.Count threads across @Topology.PhysicalCoreThreads.Count physical cores.
        @if (Topology.HasAsymmetricCache)
        {
            <text>
                The cache groups are not the same size, so which one a game runs on matters.
            </text>
        }
    </p>

    <div class="presets">
        @foreach (var preset in Presets)
        {
            <button type="button"
                    class="preset @(IsSelected(preset) ? "is-active" : string.Empty)"
                    @key="preset.Label"
                    @onclick="() => Apply(preset.Mask)">
                <span class="preset-label">@preset.Label</span>
                @if (preset.Detail is not null)
                {
                    <span class="preset-detail">@preset.Detail</span>
                }
                <code class="preset-mask">@(preset.Mask ?? "not pinned")</code>
            </button>
        }
    </div>

    <CollapsibleGroup Name="Threads" SetCount="@SelectedThreads.Count">
        <div class="threads">
            @foreach (var thread in Topology.AllThreads)
            {
                <label class="thread @(Selected.Contains(thread) ? "is-on" : string.Empty)" @key="thread">
                    <input type="checkbox"
                           checked="@Selected.Contains(thread)"
                           @onchange="@(args => ToggleThread(thread, args.Value is true))"/>
                    <span>@thread</span>
                </label>
            }
        </div>
    </CollapsibleGroup>
}

<CollapsibleGroup Name="Method">
    <div class="methods" role="radiogroup" aria-label="How the affinity is applied">
        @foreach (var option in Methods)
        {
            <button type="button"
                    class="method @(option.Method == Method ? "is-active" : string.Empty)"
                    role="radio"
                    aria-checked="@(option.Method == Method ? "true" : "false")"
                    @key="option.Method"
                    @onclick="() => ChooseMethod(option.Method)">
                <span class="method-label">@option.Label</span>
                <span class="method-detail">@option.Detail</span>
                <code class="method-token">@option.Token</code>
            </button>
        }
    </div>
</CollapsibleGroup>

<CollapsibleGroup Name="Mask">
    <p class="group-note">
        @if (UsesTaskset)
        {
            <text>Passed to <code>taskset -c</code>.</text>
        }
        else
        {
            <text>Written to <code>@LaunchOptions.WineCpuTopologyVariable</code> as a thread count and list.</text>
        }
        Clearing it removes the pinning entirely.
    </p>

    <input class="mask"
           type="text"
           spellcheck="false"
           placeholder="0-7,16-23"
           value="@Value"
           @onchange="OnMaskChanged"/>
</CollapsibleGroup>
