@inherits LayoutComponentBase

<div class="app-shell">
    <header class="titlebar">
        <span class="wordmark">
            <img class="wordmark-icon" src="titanite-icon.png" alt="" aria-hidden="true"/>
            <strong>Titanite</strong>
        </span>

        <span class="titlebar-separator" aria-hidden="true"></span>

        <nav class="nav">
            @foreach (var item in NavItems)
            {
                <NavLink class="@TabClass(item)"
                         href="@item.Path"
                         Match="@item.Match"
                         @key="item.Path">
                    @item.Label
                </NavLink>
            }
        </nav>

        <span class="titlebar-meta">
            <StartupStatus/>

            <span class="version" title="Titanite @Version">@Version</span>

            <span class="titlebar-actions">
                <UpdateButton/>

                <Button Variant="ButtonVariant.Bare"
                        OnClick="OpenRepository"
                        aria-label="Open Titanite on GitHub"
                        title="Open Titanite on GitHub">
                    <GitHubIcon/>
                </Button>
            </span>
        </span>
    </header>

    <main class="content">
        @Body
    </main>
</div>
