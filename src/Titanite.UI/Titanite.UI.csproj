<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="wwwroot/**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Titanite.UI.Tests" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Titanite.Core\Titanite.Core.csproj" />
      <ProjectReference Include="..\Titanite.Abstractions\Titanite.Abstractions.csproj" />
      <ProjectReference Include="..\Titanite.UI.Services\Titanite.UI.Services.csproj" />
    </ItemGroup>

</Project>
